[Unit]
Description=Podman Security Demo Container
After=network-online.target

[Service]
ExecStartPre=/usr/bin/env REGISTRY_AUTH_FILE=/root/.docker/config.json /usr/local/bin/cosign verify --certificate-identity "https://github.com/vjd21/podman-demo/.github/workflows/deploy.yml@refs/heads/main" --certificate-oidc-issuer "https://token.actions.githubusercontent.com" 148737623247.dkr.ecr.us-east-2.amazonaws.com/podman-demo:latest

[Container]
Image=148737623247.dkr.ecr.us-east-2.amazonaws.com/podman-demo:latest
PublishPort=8081:80

[Install]
WantedBy=default.target
